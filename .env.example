# Copy to .env and fill in. Nothing here is required for the offline harness.

# --- on-device inference (Section 3.4.2) ---
# Must stay local: adam/llm/client.py refuses non-local endpoints because
# Section 4.5.3 claims zero external egress.
ADAM_OLLAMA_HOST=http://127.0.0.1:11434
ADAM_OLLAMA_MODEL=gemma3:1b

# --- semantic memory (Section 3.1.2) ---
ADAM_WEAVIATE_HOST=http://127.0.0.1:8080

# --- governance layer (Section 3.1.3) ---
ADAM_CHAIN_RPC=https://fidesf1-rpc.fidesinnova.io
ADAM_CHAIN_ID=706883
DEPLOYER_PRIVATE_KEY=

# Populated by `npx hardhat run scripts/deploy.js`
ADAM_ADDR_GOVERNANCE=
ADAM_ADDR_CREW_REGISTRY=
ADAM_ADDR_DECISION_LOGGER=
ADAM_ADDR_CONSENSUS_VALIDATOR=

# --- Cloud-Only comparator ONLY (Section 3.4.4) ---
# ADAM does not use this. Setting it does not enable any external call from
# the ADAM runtime.
OPENAI_API_KEY=
ADAM_CLOUD_MODEL=gpt-4o-mini
